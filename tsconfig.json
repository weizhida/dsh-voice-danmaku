{
  "compilerOptions": {
    "target": "ES2022",
    // DOM 只为拿到 Blob / FormData / fetch / AbortController 这些类型：
    // Node 22 全局提供了它们，但 TypeScript 的 ES 库定义里没有，
    // 不加这一项会拿不到 BlobPart 等类型名。这里不要用 DOM 的任何运行时 API。
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
